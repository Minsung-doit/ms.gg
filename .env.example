# ==============================================================================
# carry.gg / OP.GG Commercial Production Environment Variables
# ==============================================================================

# 1. Riot Games API Configuration (https://developer.riotgames.com/)
# - 24시간 개발용 임시 키(RGAPI-xxxx) 또는 라이엇 정식 승인 프로덕션 API 키
RIOT_API_KEY='RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'

# - 키 여러 개를 돌려 쓰는 RIOT_API_KEY_POOL 은 쓰지 않는다: 한 서비스에 여러 키로
#   만료·호출 한도를 우회하는 것은 라이엇 정책 위반 소지가 있다. 개인용/정식 키 안내: docs/RIOT_API_KEY_GUIDE.md

# - 기본 서버 지역
RIOT_REGION=kr
RIOT_ROUTING_REGION=asia

# 2. Google AdSense Commercial Configuration (https://www.google.com/adsense)
# - 애드센스 게시자 ID (형식: ca-pub-XXXXXXXXXXXXXXXX)
GOOGLE_ADSENSE_CLIENT_ID='ca-pub-0000000000000000'

# 3. Server Port & AI Coach Key
PORT=3000
GEMINI_API_KEY=''

# 4. Network & Admin Security
# - 공개 서버 바인딩 주소 (기본 127.0.0.1 = 이 PC만 접근. 같은 와이파이에 공개하려면 0.0.0.0)
HOST=127.0.0.1
ADMIN_PORT=300
ADMIN_USERNAME=admin
# - 비워두면 서버 첫 실행 시 무작위 값이 자동 생성되어 .env에 저장됩니다 (기본 비밀번호 없음)
ADMIN_PASSWORD=''
ADMIN_TOKEN_SECRET=''

# 6. Messenger Integrations
DISCORD_WEBHOOK_URL=''
# 게임별 구인 채널 (선택, 없으면 위 주소로): DISCORD_WEBHOOK_URL_LOL / _PUBG / _OVERWATCH
DISCORD_WEBHOOK_URL_PUBG=''
# 구인 알림: 게임별 디스코드 역할 ID (역할을 단 멤버에게 새 구인글 알림). 예: lol=123456789012345678,pubg=...
DUO_ALERT_ROLES=''
# 디스코드 서버 이름 (사이트의 '우리 서버 랭킹' 자리에 표시)
COMMUNITY_NAME=''
# 구인글 노출 시간 (시간, 기본 6)
DUO_POST_TTL_HOURS=6
# 디스코드 봇이 멤버 대신 구인글을 쓰고 참가할 때 쓰는 비밀값 (16자 이상, 서버와 봇 .env 에 같은 값)
BOT_API_SECRET=''
# 배그 전적 연동 (선택): https://developer.pubg.com 에서 무료 키 발급. 없으면 배그는 구인만
PUBG_API_KEY=''
TELEGRAM_BOT_TOKEN=''
# - 봇은 이 Chat ID에서 온 메시지에만 응답합니다 (자동 페어링 없음)
TELEGRAM_CHAT_ID=''
# SQLite DB 위치 (OneDrive 등 동기화 폴더 밖 권장). 비우면 프로젝트 폴더의 opgg.db
OPGG_DB_PATH=

# AI 코치 요약 문장 (Anthropic API 키, 없으면 규칙 기반 코칭만)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# DB 자동 백업 (하루 1회, 최근 7개). 비우면 DB 옆 backups 폴더, OPGG_BACKUP=0 이면 끔
OPGG_BACKUP_DIR=

# 공개 주소 (검색엔진 대표 주소·사이트맵용, 예: https://jangin.gg). 비우면 상대 주소
SITE_URL=
