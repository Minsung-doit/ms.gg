# 서버용 .env 예시 — /opt/carrygg/.env 로 복사해 값 채우기 (이 파일에는 실제 값을 넣지 말 것)

# 라이엇 개인(Personal) 키
RIOT_API_KEY=

# 주소 (Caddy 가 HTTPS 처리, 앱은 내부 3000 포트)
HOST=127.0.0.1
SITE_URL=https://YOUR_DOMAIN
# 관리자 콘솔 포트. 리눅스는 1024 미만 포트를 일반 계정이 못 열어서 300 대신 3300 (SSH 터널로만 접속)
ADMIN_PORT=3300

# 데이터 위치
OPGG_DB_PATH=/var/lib/carrygg/opgg.db
OPGG_BACKUP_DIR=/var/lib/carrygg/backups

# 디스코드 서버 멤버 전용 로그인
MEMBER_LOGIN=discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# 여러 디스코드 서버를 받을 때 (서버ID:이름,서버ID:이름). 쓰면 DISCORD_GUILD_ID·COMMUNITY_NAME 대신 이걸 본다. 첫 서버가 기본 서버
COMMUNITY_GUILDS=
# 기본 서버가 아닌 서버의 채널 알림·알림 역할은 서버 ID를 붙여서: DISCORD_WEBHOOK_URL_<서버ID>=, DUO_ALERT_ROLES_<서버ID>=

# 라이엇 공식 로그인(RSO) 계정 인증 — 라이엇이 승인한 Production 앱만 발급. 서버 랭킹 계정 연결은 이것뿐 (없으면 연결 불가)
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=

# 내전 토너먼트 코드 (라이엇 토너먼트 API 승인 후 live, 흐름 시험만 stub, 비우면 꺼짐). 콜백: <SITE_URL>/api/riot/tournament/callback
RIOT_TOURNAMENT=
# 롤 구인글을 라이엇 로그인으로 인증한 본인 계정으로만 (RSO 승인 뒤 1). 비우면 라이엇에 있는 닉네임인지만 확인
RECRUIT_REQUIRE_VERIFIED=

# 관리자 (비워 두면 처음 실행 때 무작위 값이 만들어져 이 파일에 저장됨)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 디스코드 채널 웹후크 (서버 랭킹 승급 알림·듀오 구인 알림). RANKUP_ANNOUNCE=0 이면 승급 알림 끔
DISCORD_WEBHOOK_URL=
# 구인 알림 역할 (lol=역할ID,pubg=역할ID,overwatch=역할ID)
DUO_ALERT_ROLES=
# 디스코드 서버 이름 (예: OO서버)
COMMUNITY_NAME=
# 디스코드 봇 (/구인 · /구인글). 봇을 안 쓰면 비워 둠
DISCORD_BOT_TOKEN=
# 티어 역할 자동 부여 (1 이면 1시간마다, 라이엇 인증 멤버만). 봇에 '역할 관리' 권한 필요. 역할 이름 앞에 붙일 말(선택)
TIER_ROLE_SYNC=
TIER_ROLE_PREFIX=
# 봇이 서버에 멤버 대신 글·참가를 요청할 때 쓰는 비밀값 (16자 이상 아무 문자열)
BOT_API_SECRET=
# 배그 전적 연동 (선택): https://developer.pubg.com 에서 무료 키 발급. 없으면 배그는 구인만
PUBG_API_KEY=
# 노출 시간 (시간)
DUO_POST_TTL_HOURS=6
