# systemd 서비스: 서버가 켜지면 자동 시작, 꺼지면 자동 재시작
# 설치: sudo cp deploy/carrygg.service /etc/systemd/system/ && sudo systemctl enable --now carrygg
[Unit]
Description=carry.gg LoL stats site
After=network-online.target
Wants=network-online.target

[Service]
User=carrygg
WorkingDirectory=/opt/carrygg
ExecStart=/opt/carrygg/venv/bin/python run.py
Restart=always
RestartSec=3
# .env 는 /opt/carrygg/.env (app/config.py 가 읽는다)
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
